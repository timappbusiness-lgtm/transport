# Canonical origin, used for canonical links and Open Graph URLs.
# Vercel sets this per environment; locally it falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard > Project Settings > API keys). Both are safe
# in the browser: RLS decides what they reach.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tests only - never in Vercel, never in the app. The end-to-end scenario in
# tests/e2e/verification.spec.ts uses it to create confirmed test accounts and
# to delete everything it created. Without it that scenario is skipped.
# SUPABASE_SECRET_KEY=
