# Every variable this project reads, with no values.
#
# Do not fill this file in and do not copy it to .env.local by hand. Pull the
# real values from Vercel, which is the one place they are set:
#
#   vercel env pull .env.local
#
# .env and .env*.local are gitignored. A secret committed here is a secret
# published: the repository history keeps it even after it is deleted.
#
# The service-role / secret Supabase key appears nowhere in this file and
# must never reach the Next.js app. It bypasses RLS, and every authorization
# decision in Coridor is a database decision.

# ---------------------------------------------------------------------
# The Next.js app (browser-visible, hence NEXT_PUBLIC_)
# ---------------------------------------------------------------------

# Canonical origin. Feeds metadataBase, canonical links, Open Graph URLs and
# the redirect links Supabase puts in its e-mails. On a Vercel preview this
# is unset and the app falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Where reports from people without an account are sent. Unset means
# /verificare points at the contact page instead of building a mailto.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase project URL. `supabase start` prints it for local work.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key (`sb_publishable_…`). Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects issue an anon key instead; read as a fallback when
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is unset. Also safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The VAPID public key, which a browser needs before it can subscribe to
# notifications. Public by design: it identifies the sender and cannot
# send anything on its own. The private half is a Supabase secret and is
# listed with the edge-function variables below.
#
# Unset means the whole push feature is off — the settings screen says so
# instead of offering a button that cannot work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Set to 1 on production once the landing pages are ready to be indexed.
# Until then every page says noindex and robots.txt disallows everything.
NEXT_PUBLIC_SEO_INDEXABLE=

# Set by Vercel on every deployment. Never set it yourself.
# VERCEL_URL

# ---------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------

# Set to 1 to run the Playwright suite that needs a live Supabase. Without
# it those specs are skipped rather than failing.
E2E_SUPABASE=

# Mailpit / Inbucket, where local Supabase delivers confirmation e-mails.
INBUCKET_URL=

# Point Playwright at a Chromium that is already on the machine, instead of
# the one it downloads. Only needed in sandboxes that ship their own.
PLAYWRIGHT_CHROMIUM_PATH=

# Postgres connection for `pnpm db:test`. The usual PG* variables; unset
# means a local socket as the current user.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=

# ---------------------------------------------------------------------
# Edge function secrets — set with `supabase secrets set`, never here
# ---------------------------------------------------------------------
#
# These live in the Supabase project, not in this file and not in Vercel.
# Listed so the set is discoverable, commented out so nothing reads them
# from a local .env by accident.
#
# SUPABASE_URL                 injected by the runtime
# SUPABASE_ANON_KEY            injected by the runtime
# SUPABASE_SERVICE_ROLE_KEY    injected by the runtime; functions only
# ANTHROPIC_API_KEY            parse-document fails without it
# ANTHROPIC_MODEL              optional override
# ANAF_ENDPOINT                optional override for the ANAF lookup
# CRON_SECRET                  shared with n8n; unset means compliance-sweep
#                              answers 401 to everyone
# ALLOWED_ORIGIN               unset means `*`; set to the production origin
#
# Web push. The dispatcher refuses to start without all three rather than
# failing one message at a time — a missing key is a configuration mistake,
# and every message would fail identically while looking like "nobody is
# subscribed".
#
#   VAPID_PUBLIC_KEY           the same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY
#                              below; the browser needs it to subscribe and
#                              the sender needs it to identify itself
#   VAPID_PRIVATE_KEY          secret. Anybody holding it can send
#                              notifications as Coridor
#   VAPID_SUBJECT              mailto: or https:, so a push service has
#                              somebody to contact about abuse
#
# Generate a pair once, outside this repository, and set them with
# `supabase secrets set`:
#
#   npx web-push generate-vapid-keys
#
# The pair is per project and permanent: changing it invalidates every
# subscription browsers have already given us, and every one of those
# people has to accept notifications again.

# ---------------------------------------------------------------------
# CI — GitHub Actions repository secrets, never a local file
# ---------------------------------------------------------------------
#
# SUPABASE_ACCESS_TOKEN        supabase.com/dashboard/account/tokens
# SUPABASE_PROJECT_REF         ytwzydilyiekhexnpziu
# SUPABASE_DB_PASSWORD         Supabase -> Project Settings -> Database
# VERCEL_DEPLOY_HOOK_URL             Vercel -> Settings -> Git -> Deploy Hooks (branch main)
# VERCEL_AUTOMATION_BYPASS_SECRET    Vercel -> Settings -> Deployment Protection -> Bypass for Automation
