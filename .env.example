# Canonical origin. Feeds metadataBase, canonical links, Open Graph URLs and
# the redirect links Supabase puts in its e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. `supabase start` prints both of these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The publishable key (`sb_publishable_…`). Older projects issue an anon key
# instead; NEXT_PUBLIC_SUPABASE_ANON_KEY is read as a fallback. Either is
# safe in the browser.
#
# The service-role / secret key must never appear in this file or anywhere
# else in the Next.js app: it bypasses RLS, and every authorization decision
# in Coridor is a database decision.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Playwright: set to 1 to run the auth suite that needs a live Supabase.
# E2E_SUPABASE=1
# INBUCKET_URL=http://127.0.0.1:54324
