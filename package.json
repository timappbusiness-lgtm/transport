{
  "name": "transport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:test": "bash scripts/db-test.sh",
    "check:functions": "DENO_NO_PACKAGE_JSON=1 npx -y deno check --node-modules-dir=none supabase/functions/*/index.ts",
    "test:functions": "DENO_NO_PACKAGE_JSON=1 npx -y deno test --no-prompt --node-modules-dir=none supabase/functions",
    "gen:types": "bash scripts/gen-types.sh",
    "brand": "node scripts/brand/generate.ts",
    "seed:departures": "bash scripts/seed-departures.sh",
    "seed:requests": "bash scripts/seed-requests.sh",
    "anpc": "node scripts/anpc/crop.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "all-the-cities": "^3.1.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.5",
    "fontkit": "2.0.4",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "0.20.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
